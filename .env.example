# ============================================================================
# laravel-rebel-channel-discord — environment variables
# ============================================================================

# --- Discord incoming-webhook URL -------------------------------------------
# Create it in Discord:
#   1. Open the target channel (e.g. #soc-alerts) → Edit Channel (gear icon).
#   2. Integrations → Webhooks → New Webhook.
#   3. Give it a name (e.g. "Rebel SOC") and optionally an avatar; pick the channel.
#   4. Click "Copy Webhook URL" and paste it below.
# This URL is a SECRET (anyone holding it can post to the channel): keep it out of
# version control and never log it. The delivery channel registers only when set.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/your-webhook-token

# Optional per-message display overrides (leave empty to use the webhook defaults).
DISCORD_WEBHOOK_USERNAME=Rebel SOC
DISCORD_WEBHOOK_AVATAR_URL=

# Auto-register the Discord delivery channel into the Rebel Channels container
# (needs DISCORD_WEBHOOK_URL above). Set to false to keep it installed but dormant.
REBEL_DISCORD_REGISTER=true

# --- Live test suite (opt-in: POSTS A REAL MESSAGE) -------------------------
# Set to 1 and provide a real webhook URL to run tests/Live against Discord.
REBEL_DISCORD_LIVE=0
